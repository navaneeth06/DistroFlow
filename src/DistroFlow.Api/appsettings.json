{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "DistroFlow.Api",
    "Audience": "DistroFlow.Web",
    "AccessTokenMinutes": 30
  },
  "Smtp": {
    "Port": 587,
    "UseTls": true,
    "FromAddress": "no-reply@distroflow.local",
    "FromName": "DistroFlow"
  }
}
